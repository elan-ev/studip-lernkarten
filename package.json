{
    "name": "lernkarten",
    "type": "module",
    "version": "1.4.0",
    "files": [
        "dist"
    ],
    "main": "./dist/lernkarten.umd.cjs",
    "module": "./dist/lernkarten.js",
    "exports": {
        ".": {
            "import": "./dist/my-lib.js",
            "require": "./dist/my-lib.umd.cjs"
        }
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --config courseware/vite.config.js",
        "preview": "vite preview",
        "watch": "vite build --watch --mode=development",
        "build:courseware": "vite build --config courseware/vite.config.js",
        "watch:courseware": "vite build --watch --mode=development --config courseware/vite.config.js",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
        "format": "prettier --write src/",
        "gettext:compile": "vue-gettext-compile",
        "gettext:extract": "vue-gettext-extract",
        "prezip": "npm i && npm run build && composer install --no-dev",
        "zip": "zip -r Stud.IP-Lernkarten-v$npm_package_version.zip lib locale migrations vendor dist courseware/dist plugin.manifest LernkartenPlugin.php CoursewareLernkartenBlockPlugin.php LICENSE README"
    },
    "dependencies": {
        "pinia": "^2.1.7",
        "vue": "^3.5.43",
        "vue-router": "^4.2.5",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@ckeditor/ckeditor5-vue": "^4.0.1",
        "@headlessui/vue": "^1.7.23",
        "@rushstack/eslint-patch": "^1.3.3",
        "@vitejs/plugin-vue": "6.0",
        "@vue/eslint-config-prettier": "^8.0.0",
        "autoprefixer": "^10.6.1",
        "eslint": "^8.49.0",
        "eslint-plugin-vue": "^9.17.0",
        "fsrs.js": "^1.1.2",
        "kitsu": "^11.1.0",
        "papaparse": "^5.7.0",
        "pinia-plugin-persistedstate": "^3.2.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.7",
        "tailwindcss": "^3.3.5",
        "vite": "^8.3.0",
        "vue-resizable": "^2.1.7",
        "vue3-dropzone": "^2.2.1",
        "vue3-gettext": "^3.0.0-beta.1"
    }
}
